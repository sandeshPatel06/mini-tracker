# ==============================================================================
# get-Hike — Environment Configuration & Secrets Template
# Copy this file to `.env` and fill in your specific credentials.
# Every variable is optional; sensible defaults are used when unset.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini AI Analysis
# ------------------------------------------------------------------------------
# Get your Gemini API Key from Google AI Studio: https://aistudio.google.com/app/apikey
# Without a key, captures queue locally and are analyzed once a key is configured.
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred Gemini model. Auto-discovery and failover run automatically when unset.
GEMINI_MODEL=models/gemma-4-31b-it

# ------------------------------------------------------------------------------
# 2. Activity Tracker & Analysis Scheduling
# ------------------------------------------------------------------------------
# Interval between screenshot captures (accepts 30, 30s, 1m, ...)
SCREENSHOT_INTERVAL_SECONDS=30

# AI batch analysis interval (3h, 10m, ...). The desktop app clamps automatic
# runs between 2 and 15 minutes; the standalone server uses the value as-is.
AI_ANALYSIS_INTERVAL_SECONDS=3h

# ------------------------------------------------------------------------------
# 3. Data & Web Server
# ------------------------------------------------------------------------------
# Data directory (SQLite DB, screenshots, logs). Default: ~/.local/share/get-hike
# DATA_DIR=/custom/data/dir

# Optional PostgreSQL DSN for server mode. Empty/absent = SQLite in DATA_DIR.
# DATABASE_URL=postgres://user:pass@localhost:5432/get_hike?sslmode=disable

# HTTP server port (standalone get-hike-server and Docker)
PORT=8080

# Timezone used to bucket analytics by day (IANA name, e.g. Asia/Kolkata).
# Defaults to the system timezone — important for Docker, which defaults to UTC.
# TZ=Asia/Kolkata

# Desktop backend sync settings
BACKEND_PORT=8080
BACKEND_ENDPOINT=http://localhost:8080
BACKEND_URL=http://localhost:8080

# Public base URL used to build OAuth callback URLs when GOOGLE_REDIRECT_URI /
# AZURE_REDIRECT_URI are not set
APP_URL=http://localhost:8080

# Frontend-facing backend URL baked into Vite builds (first non-empty wins)
VITE_BACKEND_URL=http://localhost:8080
# VITE_API_URL=http://localhost:8080
# VITE_BACKEND_ENDPOINT=http://localhost:8080

# ------------------------------------------------------------------------------
# 4. Web Sessions & Security
# ------------------------------------------------------------------------------
# JWT signing key for web sessions. Strongly recommended for server mode: if
# unset, an ephemeral per-process key is generated and all sessions expire on
# every server restart.
# JWT_SECRET=change_me_to_a_long_random_string

# Allow the OAuth test-login shortcut (?mock=true / ?test=true). Keep unset or
# "false" in production — enabling it bypasses real OAuth.
# ALLOW_MOCK_OAUTH=false

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 Single Sign-On (Optional)
# ------------------------------------------------------------------------------
# Create OAuth 2.0 Credentials in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback

# ------------------------------------------------------------------------------
# 6. Microsoft Azure AD / Entra ID OAuth Configuration (Optional)
# ------------------------------------------------------------------------------
# Register App in Azure Portal / Entra ID:
# https://portal.azure.com/#view/Microsoft_AAD_IAM/ActiveDirectoryMenuBlade/~/RegisteredApps
# Authorized redirect URI: http://localhost:8080/api/auth/oauth/azure/callback
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_here
AZURE_TENANT_ID=common
AZURE_REDIRECT_URI=http://localhost:8080/api/auth/oauth/azure/callback

# ------------------------------------------------------------------------------
# 7. SMTP Email Server (Optional — organization invitations)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@get-hike.local
