---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CodeBlock from '../components/CodeBlock.astro';

const githubUrl = 'https://github.com/sandeshPatel06/mini-tracker';
---

<BaseLayout
  title="Quick Start with get-Hike: Installation & Setup Guide"
  description="Step-by-step install guide for get-Hike on Linux. Prerequisites, one-line installer, manual build, systemd service, and troubleshooting."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-16">
    
    <!-- Header -->
    <header class="mb-8 sm:mb-10 border-b border-emerald-500/15 pb-6 sm:pb-8">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-mono font-semibold mb-3 sm:mb-4">
        INSTALLATION &amp; SETUP GUIDE
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-3 sm:mb-4">
        Install get-Hike on Linux
      </h1>
      <p class="text-sm sm:text-lg text-slate-300 leading-relaxed max-w-3xl mb-5 sm:mb-6">
        Set up get-Hike in minutes with the automated installer, download pre-built GitHub release binaries, or compile from source.
      </p>

      <!-- Pre-built Binary Banner -->
      <aside class="p-3.5 sm:p-5 rounded-xl bg-emerald-950/30 border border-emerald-500/30 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4">
        <div class="space-y-1">
          <div class="text-sm font-bold text-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            Prefer pre-compiled binaries?
          </div>
          <p class="text-xs text-slate-300">
            Download verified executables for Linux x64/ARM64, Windows .exe, or macOS directly without installing Go or Node.
          </p>
        </div>
        <Button href="/mini-tracker/download" variant="primary" size="sm" class="shrink-0 w-full sm:w-auto">
          Go to Downloads
        </Button>
      </aside>
    </header>

    <!-- Quick Navigation Index -->
    <nav class="mb-8 sm:mb-12 p-3.5 sm:p-5 rounded-xl sm:rounded-2xl glass-card" aria-label="Table of contents">
      <h2 class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-emerald-400 font-mono mb-2.5 sm:mb-3">Table of Contents</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 text-xs sm:text-sm text-slate-300">
        <li><a href="#prerequisites" class="hover:text-emerald-300 transition-colors block py-1">1. Prerequisites</a></li>
        <li><a href="#quick-install" class="hover:text-emerald-300 transition-colors block py-1">2. One-Line Install</a></li>
        <li><a href="#manual-build" class="hover:text-emerald-300 transition-colors block py-1">3. Manual Compilation</a></li>
        <li><a href="#guest-mode" class="hover:text-emerald-300 transition-colors block py-1">4. Running in Guest Mode</a></li>
        <li><a href="#systemd" class="hover:text-emerald-300 transition-colors block py-1">5. systemd User Service</a></li>
        <li><a href="#troubleshooting" class="hover:text-emerald-300 transition-colors block py-1">6. Troubleshooting</a></li>
      </ul>
    </nav>

    <div class="space-y-8 sm:space-y-14">
      
      <!-- Section 1: Prerequisites -->
      <section id="prerequisites" class="scroll-mt-24">
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 sm:mb-4 flex items-center gap-2">
          <span class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-xs font-mono text-emerald-400">01</span>
          System Prerequisites
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
          get-Hike is engineered for Linux distributions running either X11 or Wayland (with capture tools). If compiling from source, you will need:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
          <article class="p-4 rounded-xl bg-slate-900 border border-slate-800">
            <header class="font-mono text-emerald-400 font-semibold text-sm mb-1">Linux OS</header>
            <p class="text-xs text-slate-400">Ubuntu 22.04+, Debian 12+, Fedora 38+, Arch Linux</p>
          </article>
          <article class="p-4 rounded-xl bg-slate-900 border border-slate-800">
            <header class="font-mono text-emerald-400 font-semibold text-sm mb-1">Go Toolchain</header>
            <p class="text-xs text-slate-400">Go 1.22+ required for backend daemon compilation</p>
          </article>
          <article class="p-4 rounded-xl bg-slate-900 border border-slate-800">
            <header class="font-mono text-emerald-400 font-semibold text-sm mb-1">Node &amp; npm</header>
            <p class="text-xs text-slate-400">Node 18+ for compiling the frontend UI bundle</p>
          </article>
        </div>

        <p class="text-xs text-slate-400 break-words leading-relaxed">
          Required system libraries: <code class="text-emerald-300 bg-slate-900 px-1.5 py-0.5 rounded font-mono break-all">libayatana-appindicator3-dev</code>, <code class="text-emerald-300 bg-slate-900 px-1.5 py-0.5 rounded font-mono break-all">libgtk-3-dev</code>, <code class="text-emerald-300 bg-slate-900 px-1.5 py-0.5 rounded font-mono break-all">libwebkit2gtk-4.0-dev</code> (or 4.1).
        </p>
      </section>

      <!-- Section 2: One-Line Install -->
      <section id="quick-install" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-white mb-4 flex items-center gap-2">
          <span class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-xs font-mono text-emerald-400">02</span>
          One-Line Installation (Linux)
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
          Install directly from the web without cloning:
        </p>

        <div class="space-y-4">
          <CodeBlock
            code="curl -sSL https://raw.githubusercontent.com/sandeshPatel06/mini-tracker/main/install.sh | bash"
            label="Direct curl installation"
          />

          <p class="text-xs text-slate-400">Or clone and inspect the script locally before running:</p>

          <CodeBlock
            code="git clone https://github.com/sandeshPatel06/mini-tracker.git && cd mini-tracker && ./install.sh"
            label="Clone & local installer"
          />
        </div>

        <aside class="mt-4 p-4 rounded-xl bg-emerald-950/20 border border-emerald-500/20 text-sm text-slate-300 space-y-1">
          <div class="font-semibold text-emerald-400">What the installer does:</div>
          <ul class="list-disc list-inside text-xs text-slate-400 space-y-1 pt-1">
            <li>Downloads the verified GitHub release binary for your architecture (or builds locally)</li>
            <li>Installs executable to <code class="text-emerald-300 font-mono">~/.local/bin/get-hike</code></li>
            <li>Registers a desktop launcher icon in your Linux application menu</li>
            <li>Sets up a systemd user service autostart unit</li>
          </ul>
        </aside>
      </section>

      <!-- Section 3: Manual Build -->
      <section id="manual-build" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-white mb-4 flex items-center gap-2">
          <span class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-xs font-mono text-emerald-400">03</span>
          Manual Compilation &amp; Makefile Targets
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
          If you want to build from source using the repository Makefile:
        </p>

        <div class="space-y-4">
          <div>
            <div class="text-xs font-mono text-slate-400 mb-1">Option A: Build native desktop app (Wails + Go)</div>
            <CodeBlock code="make build" label="Makefile: desktop app" />
          </div>

          <div>
            <div class="text-xs font-mono text-slate-400 mb-1">Option B: Build zero-dependency standalone server (Port 8080)</div>
            <CodeBlock code="make build-server && ./server" label="Makefile: web server" />
          </div>

          <div>
            <div class="text-xs font-mono text-slate-400 mb-1">Option C: Setup Zero-Sudo hardware input tracking</div>
            <CodeBlock code="make setup-input" label="Makefile: setup /dev/input permissions" />
          </div>
        </div>
      </section>

      <!-- Section 4: Guest Mode -->
      <section id="guest-mode" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-white mb-4 flex items-center gap-2">
          <span class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-xs font-mono text-emerald-400">04</span>
          Guest Mode vs Cloud Server
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
          get-Hike is engineered to work out of the box with zero external configuration:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <article class="p-6 rounded-2xl bg-slate-900 border border-emerald-500/30">
            <header class="text-emerald-400 font-bold text-base mb-2 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              Guest Mode (Default &amp; Recommended)
            </header>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-3">
              No account, login, or database server required. Launch the application, click "Continue as Guest", and start tracking immediately.
            </p>
            <div class="text-xs font-mono text-slate-400 bg-slate-950 p-2.5 rounded-lg border border-slate-800 break-all">
              Data saved: ~/.local/share/get-hike/
            </div>
          </article>

          <article class="p-6 rounded-2xl bg-slate-900 border border-slate-800">
            <header class="text-slate-200 font-bold text-base mb-2 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-blue-400"></span>
              Team Mode (Optional)
            </header>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-3">
              For teams requiring shared organization metrics. Configure <code class="text-slate-200 font-mono">config.yaml</code> with PostgreSQL, JWT secrets, and Google/Azure OAuth credentials.
            </p>
            <div class="text-xs font-mono text-slate-400 bg-slate-950 p-2.5 rounded-lg border border-slate-800 break-all">
              Server binary: ./server (port 8080)
            </div>
          </article>
        </div>
      </section>

      <!-- Section 5: systemd Service -->
      <section id="systemd" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-white mb-4 flex items-center gap-2">
          <span class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-xs font-mono text-emerald-400">05</span>
          systemd User Service
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
          Keep get-Hike running smoothly as a background user service without needing sudo:
        </p>

        <div class="space-y-3">
          <CodeBlock
            code="systemctl --user enable --now get-hike.service"
            label="Enable Service"
          />
          <CodeBlock
            code="systemctl --user status get-hike.service"
            label="Check Status"
          />
        </div>
      </section>

      <!-- Section 6: Troubleshooting & Removal -->
      <section id="troubleshooting" class="scroll-mt-24">
        <h2 class="text-2xl font-bold text-white mb-4 flex items-center gap-2">
          <span class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-xs font-mono text-emerald-400">06</span>
          Troubleshooting &amp; Clean Removal
        </h2>

        <div class="space-y-4 text-sm text-slate-300">
          <article class="p-4 rounded-xl bg-slate-900 border border-slate-800">
            <h3 class="font-semibold text-white mb-1">Wayland capture permissions</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Under Wayland (GNOME/KDE), your compositor may prompt you on the first capture to authorize screen streaming via PipeWire. Ensure <code class="font-mono text-emerald-300">xdg-desktop-portal</code> is installed and running.
            </p>
          </article>

          <article class="p-4 rounded-xl bg-slate-900 border border-slate-800">
            <h3 class="font-semibold text-white mb-1">Port 8080 collision (Server Mode)</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              If running in server mode and port 8080 is already bound, edit <code class="font-mono text-emerald-300">config.yaml</code> or set <code class="font-mono text-emerald-300">PORT=8090</code> in your environment.
            </p>
          </article>

          <article class="p-4 rounded-xl bg-slate-900 border border-slate-800">
            <h3 class="font-semibold text-white mb-1">Clean uninstallation</h3>
            <p class="text-xs text-slate-400 leading-relaxed mb-2">
              To remove get-Hike cleanly at any time:
            </p>
            <CodeBlock code="./uninstall.sh" label="Uninstall get-Hike" />
          </article>
        </div>
      </section>

    </div>

    <!-- Bottom help banner -->
    <footer class="mt-12 sm:mt-16 p-5 sm:p-8 rounded-2xl glass-panel text-center">
      <h2 class="text-xl font-bold text-white mb-2">Need more assistance?</h2>
      <p class="text-sm text-slate-400 max-w-xl mx-auto mb-6">
        Check out the full repository README for comprehensive build tags, database migration scripts, and architecture docs.
      </p>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4">
        <Button href={githubUrl} variant="primary" size="md" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto">
          View full GitHub README
        </Button>
        <Button href="/mini-tracker/privacy" variant="outline" size="md" class="w-full sm:w-auto">
          Review Privacy Policy
        </Button>
      </div>
    </footer>

  </div>
</BaseLayout>
