---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Page Not Found (404): get-Hike"
  description="The page you are looking for does not exist on get-Hike."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-32 text-center flex-grow flex flex-col items-center justify-center">
    
    <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mb-6 font-mono text-2xl font-bold">
      404
    </div>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
      Lost on the trail?
    </h1>

    <p class="text-base sm:text-lg text-slate-300 max-w-lg mb-8 leading-relaxed">
      The page you requested could not be found. Perhaps it moved or never existed. Your productivity data, however, remains safe on your machine.
    </p>

    <div class="flex flex-col sm:flex-row items-center gap-3">
      <Button href="/mini-tracker/" variant="primary" size="md" class="w-full sm:w-auto">
        Back to Homepage
      </Button>
      <Button href="/mini-tracker/get-started" variant="outline" size="md" class="w-full sm:w-auto">
        Install Guide
      </Button>
    </div>

  </div>
</BaseLayout>
