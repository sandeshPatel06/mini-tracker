meta {
  name: Register Organization
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/org/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Acme Corp",
    "full_name": "Admin User",
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}
