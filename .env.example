# ==============================================================================
# Mini Tracker — Environment Configuration & Secrets Template
# Copy this file to `.env` and fill in your specific credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini AI Analysis Configuration
# ------------------------------------------------------------------------------
# Get your Gemini API Key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Specify the Gemini AI model to use directly (e.g. Gemma 4 31B IT, gemini-1.5-flash, gemini-1.5-pro)


# ------------------------------------------------------------------------------
# 2. Activity Tracker & Collector Settings
# ------------------------------------------------------------------------------
# Interval between screenshot captures and entropy scoring (e.g. 30s, 1m)
SCREENSHOT_INTERVAL_SECONDS=30

# Interval for background AI batch analysis of unanalyzed logs
AI_ANALYSIS_INTERVAL=3h

# ------------------------------------------------------------------------------
# 3. Web Server & Endpoint Settings
# ------------------------------------------------------------------------------
# Port for mini-tracker HTTP backend server
PORT=8080
BACKEND_PORT=8080
BACKEND_ENDPOINT=http://localhost:8080
BACKEND_URL=http://localhost:8080
APP_URL=http://localhost:8080

# Frontend-facing backend URL (used by Vite builds for cross-origin desktop or remote deployments)
# Set this to the externally reachable address of the backend server.
VITE_BACKEND_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 Single Sign-On Configuration (Optional)
# ------------------------------------------------------------------------------
# Create OAuth 2.0 Credentials in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback

# ------------------------------------------------------------------------------
# 5. Microsoft Azure AD / Entra ID OAuth Configuration (Optional)
# ------------------------------------------------------------------------------
# Register App in Azure Portal / Entra ID:
# https://portal.azure.com/#view/Microsoft_AAD_IAM/ActiveDirectoryMenuBlade/~/RegisteredApps
# Authorized redirect URI: http://localhost:8080/api/auth/oauth/azure/callback
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_here
AZURE_TENANT_ID=common
AZURE_REDIRECT_URI=http://localhost:8080/api/auth/oauth/azure/callback

# ------------------------------------------------------------------------------
# 6. SMTP Email Server Configuration (Optional - for inviting team members)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@mini-tracker.local
