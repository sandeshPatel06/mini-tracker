---
import Button from './Button.astro';

const navLinks = [
  { label: 'Download', href: '/mini-tracker/download' },
  { label: 'Features', href: '/mini-tracker/features' },
  { label: 'Get started', href: '/mini-tracker/get-started' },
  { label: 'Privacy', href: '/mini-tracker/privacy' },
  { label: 'Changelog', href: '/mini-tracker/changelog' },
];

const githubUrl = 'https://github.com/sandeshPatel06/mini-tracker';
const releasesUrl = 'https://github.com/sandeshPatel06/mini-tracker/releases';
const currentPath = Astro.url.pathname;
---

<template class="theme-toggle-template">
  <button
    type="button"
    class="theme-toggle flex size-11 items-center justify-center rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/80 transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-emerald-500"
    aria-label="Switch dark / light theme"
    title="Toggle dark / light theme"
  >
    <svg class="icon-moon w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
    </svg>
    <svg class="icon-sun w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path stroke-linecap="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
    </svg>
  </button>
</template>

<header
  class="sticky top-0 z-50 w-full backdrop-blur-md bg-slate-950/80 border-b border-emerald-500/15 transition-colors duration-200"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Logo -->
      <a
        href="/mini-tracker/"
        class="flex items-center gap-3 group focus-visible:outline-2 focus-visible:outline-emerald-500 rounded-lg p-1 -ml-1"
        aria-label="get-Hike Home"
      >
        <div class="w-9 h-9 rounded-xl bg-slate-900 border border-emerald-500/30 flex items-center justify-center p-1 shadow-md group-hover:border-emerald-400 group-hover:shadow-emerald-500/20 transition-all duration-200">
          <img
            src="/mini-tracker/app-logo.png"
            alt="get-Hike App Logo"
            class="w-7 h-7 object-contain group-hover:scale-105 transition-transform duration-200"
            width="28"
            height="28"
          />
        </div>
        <span class="text-xl font-bold tracking-tight text-white group-hover:text-emerald-400 transition-colors">
          get-Hike
        </span>
        <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 hidden sm:inline-block">
          Open Source
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Main navigation">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors duration-150 ${
                isActive
                  ? 'text-emerald-400 bg-emerald-500/10'
                  : 'text-slate-300 hover:text-white hover:bg-slate-800/60'
              }`}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Actions -->
      <div class="hidden md:flex items-center gap-3">
        <!-- GitHub Link -->
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex size-11 items-center justify-center rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/80 transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-emerald-500"
          aria-label="GitHub Repository"
          title="View on GitHub"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>

        <!-- Theme Toggle -->
        <span class="theme-slot hidden md:inline"></span>

        <!-- Download CTA -->
        <Button href="/mini-tracker/download" variant="primary" size="sm">
          Download
        </Button>
      </div>

      <!-- Mobile cluster -->
      <div class="flex items-center gap-2 md:hidden">
        <!-- Theme Toggle -->
        <span class="theme-slot"></span>

        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex size-11 items-center justify-center rounded-lg text-slate-300 hover:text-white"
          aria-label="GitHub"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>

        <button
          type="button"
          id="mobile-menu-btn"
          class="flex size-11 items-center justify-center rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/80 transition-colors focus-visible:outline-2 focus-visible:outline-emerald-500"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <!-- Hamburger lines -->
          <svg
            id="menu-icon-open"
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close icon -->
          <svg
            id="menu-icon-close"
            class="w-6 h-6 hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer / Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-b border-emerald-500/20 bg-slate-950/95 backdrop-blur-xl px-4 pt-3 pb-6 space-y-3"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile Navigation Menu"
  >
    <nav class="flex flex-col space-y-1">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
              isActive
                ? 'text-emerald-400 bg-emerald-500/10'
                : 'text-slate-200 hover:text-white hover:bg-slate-900'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="pt-3 border-t border-slate-800/80 flex flex-col gap-2.5">
      <Button href="/mini-tracker/download" variant="primary" size="md" class="w-full text-center">
        Download
      </Button>
      <Button
        href={releasesUrl}
        variant="outline"
        size="md"
        class="w-full text-center"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub Releases &amp; Builds
      </Button>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  if (menuBtn && mobileMenu && openIcon && closeIcon) {
    const toggleMenu = (open?: boolean) => {
      const isExpanded = open ?? menuBtn.getAttribute('aria-expanded') === 'true';
      const shouldOpen = !isExpanded;

      menuBtn.setAttribute('aria-expanded', String(shouldOpen));
      if (shouldOpen) {
        mobileMenu.classList.remove('hidden');
        openIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      } else {
        mobileMenu.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        document.body.style.overflow = '';
      }
    };

    menuBtn.addEventListener('click', () => toggleMenu());

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
        toggleMenu(true);
        menuBtn.focus();
      }
    });

    // Close when clicking a link inside the mobile menu
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggleMenu(true);
      });
    });
  }
</script>

<script>
  const tpl = document.querySelector('template.theme-toggle-template');
  const slots = document.querySelectorAll('.theme-slot');
  if (tpl && slots.length) {
    const applyAria = () => {
      const t = document.documentElement.getAttribute('data-theme');
      slots.forEach((s) => {
        const btn = s.querySelector('.theme-toggle');
        if (btn) btn.setAttribute('aria-pressed', String(t === 'light'));
      });
    };
    slots.forEach((s) => {
      s.appendChild(tpl.content.cloneNode(true));
      s.querySelector('.theme-toggle').addEventListener('click', () => {
        const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('gh-theme', next); } catch (_) {}
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', next === 'light' ? '#f4f8fa' : '#10b981');
        applyAria();
      });
    });
    applyAria();
  }
</script>
