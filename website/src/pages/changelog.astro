---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

const releases = [
  {
    version: 'v1.0.0-rc1',
    date: 'October 18, 2026',
    title: 'Background Daemon, Developer Panel & Telemetry Enhancements',
    badge: 'Latest',
    highlights: [
      'Detached background daemon continues screenshot capture, mouse metrics, and AI analysis even if GUI window is closed',
      'PID lifecycle management with duplicate-daemon guards and clean SIGTERM handling',
      'Integrated Developer & Diagnostics panel with live log tailing, database metrics, and masked secret inspection',
      'Server-side persistence for web guest AI results via loopback API',
      'Formal MIT License by REAK INFOTECH LLP',
    ],
  },
  {
    version: 'v0.9.0',
    date: 'August 2026',
    title: 'Gemini AI Batch Evaluation & Floating Companion',
    highlights: [
      'Automated batch evaluation with Google Gemini API models',
      'Dynamic productivity scoring and task classification (Coding, Review, Docs, Research)',
      'Compact floating desktop companion widget for Linux desktops',
      'Interactive timeline capture viewer with application filtering',
    ],
  },
  {
    version: 'v0.8.0',
    date: 'April 2026',
    title: 'Linux Input Telemetry & Entropy Scoring',
    highlights: [
      'Replaced intrusive key capture with Shannon keystroke entropy calculation',
      'Native Linux mouse displacement tracking and click accumulator',
      'X11 and Wayland screen capture pipeline with local storage pruning',
      'Local SQLite embedded storage under ~/.local/share/get-hike/',
    ],
  },
];

const githubReleasesUrl = 'https://github.com/sandeshPatel06/mini-tracker/releases';
---

<BaseLayout
  title="Changelog — get-Hike Product Updates"
  description="All notable releases and updates to get-Hike: background tracking daemon, Gemini AI batch scoring, and Linux desktop integration."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-16">
    
    <!-- Header -->
    <div class="border-b border-emerald-500/15 pb-6 sm:pb-8 mb-8 sm:mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-mono font-semibold mb-3 sm:mb-4">
        RELEASE NOTES
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-3 sm:mb-4">
        Product Changelog
      </h1>
      <p class="text-sm sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
        Track progress, updates, and architectural enhancements shipped in get-Hike.
      </p>
    </div>

    <!-- Release List -->
    <div class="space-y-6 sm:space-y-12">
      {releases.map((rel) => (
        <article class="p-4 sm:p-8 rounded-xl sm:rounded-2xl glass-card relative">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3 sm:mb-4">
            <div class="flex items-center gap-2.5 sm:gap-3">
              <span class="text-lg sm:text-xl font-bold font-mono text-emerald-400 break-all sm:break-normal">{rel.version}</span>
              {rel.badge && (
                <span class="text-[10px] sm:text-xs px-2 sm:px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 font-semibold border border-emerald-500/30">
                  {rel.badge}
                </span>
              )}
            </div>
            <time class="text-xs font-mono text-slate-400 break-words">{rel.date}</time>
          </div>

          <h2 class="text-base sm:text-xl font-bold text-white mb-2.5 sm:mb-3">
            {rel.title}
          </h2>

          <ul class="space-y-2 text-xs sm:text-sm text-slate-300 mb-4 sm:mb-6">
            {rel.highlights.map((item) => (
              <li class="flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold mt-0.5 shrink-0">●</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <!-- GitHub Releases CTA -->
    <div class="mt-8 sm:mt-14 text-center p-5 sm:p-8 rounded-xl sm:rounded-2xl border border-slate-800 bg-slate-900/60">
      <h2 class="text-base sm:text-lg font-bold text-white mb-2">Want complete commit history?</h2>
      <p class="text-xs sm:text-sm text-slate-400 mb-5 sm:mb-6 max-w-md mx-auto">
        Every line of code and release tag is available publicly on our GitHub repository.
      </p>
      <Button href={githubReleasesUrl} variant="primary" size="md" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto">
        View Releases on GitHub
      </Button>
    </div>

  </div>
</BaseLayout>
