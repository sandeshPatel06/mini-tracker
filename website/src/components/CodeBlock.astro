---
interface Props {
  code: string;
  language?: string;
  label?: string;
  class?: string;
}

const {
  code,
  language = 'bash',
  label = 'Terminal command',
  class: className = '',
} = Astro.props;

const uniqueId = `code-block-${Math.random().toString(36).substring(2, 9)}`;
---

<div
  class={`relative group rounded-xl bg-slate-950/95 border border-emerald-500/20 shadow-xl overflow-hidden font-mono text-xs sm:text-sm ${className}`}
  role="region"
  aria-label={label}
>
  <!-- Window Header with Copy Button -->
  <div class="flex items-center justify-between px-3.5 py-2 bg-slate-900/90 border-b border-emerald-500/10 text-xs text-slate-400 select-none">
    <div class="flex items-center gap-2">
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-red-500/70 inline-block"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-amber-500/70 inline-block"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/70 inline-block"></span>
      </div>
      <span class="ml-1.5 font-mono text-slate-400 text-[11px]">{language}</span>
    </div>

    <div class="flex items-center gap-3">
      <span class="text-[11px] text-slate-500 hidden sm:inline">{label}</span>
      <button
        type="button"
        id={`${uniqueId}-btn`}
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-800/80 hover:bg-emerald-500/20 text-slate-300 hover:text-emerald-300 border border-slate-700/60 hover:border-emerald-500/40 transition-all duration-200 text-xs font-sans focus-visible:outline-2 focus-visible:outline-emerald-500"
        aria-label="Copy to clipboard"
        title="Copy to clipboard"
      >
        <!-- Copy Icon -->
        <svg
          id={`${uniqueId}-copy-icon`}
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
          />
        </svg>
        <!-- Check Icon -->
        <svg
          id={`${uniqueId}-check-icon`}
          class="w-3.5 h-3.5 text-emerald-400 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 13l4 4L19 7"
          />
        </svg>
        <span id={`${uniqueId}-btn-text`} class="text-[11px] font-medium">Copy</span>
      </button>
    </div>
  </div>

  <!-- Content with smooth horizontal scroll -->
  <div class="p-3.5 sm:p-4 overflow-x-auto scrollbar-thin">
    <pre class="m-0 text-slate-200 text-xs sm:text-sm leading-relaxed whitespace-pre font-mono"><span class="text-emerald-400 select-none">$ </span><code id={`${uniqueId}-code`}>{code}</code></pre>
  </div>
</div>

<script define:vars={{ uniqueId, code }}>
  const btn = document.getElementById(`${uniqueId}-btn`);
  const btnText = document.getElementById(`${uniqueId}-btn-text`);
  const copyIcon = document.getElementById(`${uniqueId}-copy-icon`);
  const checkIcon = document.getElementById(`${uniqueId}-check-icon`);

  if (btn && copyIcon && checkIcon && btnText) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code);
      } catch (err) {
        // Fallback
        const textarea = document.createElement('textarea');
        textarea.value = code;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }

      copyIcon.classList.add('hidden');
      checkIcon.classList.remove('hidden');
      btnText.textContent = 'Copied!';
      btn.setAttribute('aria-label', 'Copied to clipboard');

      setTimeout(() => {
        checkIcon.classList.add('hidden');
        copyIcon.classList.remove('hidden');
        btnText.textContent = 'Copy';
        btn.setAttribute('aria-label', 'Copy to clipboard');
      }, 2000);
    });
  }
</script>
