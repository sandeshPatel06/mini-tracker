# Mini Tracker Application Configuration Example (Viper)
# Copy this file to config.yaml and customize for your environment.

# Database Connection (PostgreSQL for corporate backend, or leave blank for local SQLite)
database_url: "postgres://user:password@localhost:5432/tracker?sslmode=disable"

# Google Gemini Vision API Configuration
gemini_api_key: "YOUR_GEMINI_API_KEY_HERE"
gemini_model: "models/gemini-3.5-flash-lite"

# Intervals & Schedules
screenshot_interval_seconds: 30s
ai_analysis_interval_seconds: 3h

# Network & Server Port Settings
backend_port: 8080
backend_endpoint: "http://localhost:8080"

# Data Directory (SQLite DB, screenshots, logs). Default: ~/.local/share/get-hike
data_dir: "/custom/data/dir"

# Google OAuth 2.0 SSO (optional)
google_client_id: "your_google_client_id.apps.googleusercontent.com"
google_client_secret: "your_google_client_secret_here"

# Microsoft Azure AD / Entra ID SSO (optional)
azure_client_id: "your_azure_client_id_here"
azure_client_secret: "your_azure_client_secret_here"
azure_tenant_id: "common"
